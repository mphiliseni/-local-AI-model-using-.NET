      "link": null,
      "locked": false,
      "text": "This app runs a simple chat loop in the terminal:\n\n- prompts the user for input\n- sends the message to the local model\n- streams the response back to the console\n- keeps a short in-memory chat history",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This app runs a simple chat loop in the terminal:\n\n- prompts the user for input\n- sends the message to the local model\n- streams the response back to the console\n- keeps a short in-memory chat history",
      "autoResize": true,
      "lineHeight": 1.25
    },
