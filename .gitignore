## Ignore Visual Studio temporary files, build results, and
## user-specific files

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# JetBrains Rider
.idea/

# VS Code
.vscode/

# Build artifacts
bin/
obj/
**/bin/
**/obj/

# Publish directory
publish/

# NuGet
*.nupkg
packages/
.nuget/

# Runtime and diagnostics
*.runtimeconfig.json
*.deps.json
*.dll
*.exe
*.pdb

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# User secrets
secrets.json

# Rider / ReSharper
*.DotSettings.user
.ReSharper*/

# Node
node_modules/

# Others
*.iml
